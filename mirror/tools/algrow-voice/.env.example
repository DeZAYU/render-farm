# Copy to .env and fill in. Algrow key: algrow.online dashboard -> API.
ALGO_API_KEY=your-algrow-key
# Voice name or voice_id (list them: python algrow_voice.py voices)
ALGO_TTS_VOICE=default-pd4i7bs8z6-qjsqmqbjlxg__horror_channel_tokyo
ALGO_TTS_PROVIDER=stealth
# Optional: Stealth model version (default 1.5)
# ALGO_TTS_STEALTH_MODEL=1.5
